  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one solid action per form, in register-cover navy.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Save</button>",
      "css": ":host{--paper:#f3f5f9;--sheet:#fff;--ink:#14171f;--ink-2:#4b5263;--ink-3:#626a7b;--rule:#e2e6ee;--rule-strong:#c9d0dc;--rail:#1b2c57;--rail-ink:#eef2fb;--rail-ink-2:#aebbd9;--rail-hover:#22376a;--rail-active:#2b4384;--blue:#256abf;--blue-wash:#eaf2fd;--red:#c4373a;--mark-0:#e6eaf1;--slot-line:#b9c1cf;--mark-1:#86b6ef;--mark-2:#3987e5;--mark-3:#1c5cab;--mark-4:#0d366b;}.ds-btn-primary{font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;background:var(--rail);color:var(--rail-ink);border:0;border-radius:8px;padding:8px 16px;font-size:.875rem;font-weight:500;cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:var(--rail-active)}.ds-btn-primary:focus-visible{outline:2px solid var(--blue);outline-offset:2px}.ds-btn-primary:disabled{opacity:.6}"
    },
    {
      "name": "Action Link",
      "kind": "button",
      "refersTo": "link-action",
      "description": "Sentence-level action with a trailing arrow; red variant only for owner decisions.",
      "html": "<div class=\"ds-links\"><a class=\"ds-link\" href=\"#\">See all 14 in People <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a><a class=\"ds-link ds-link-decision\" href=\"#\">Review removals <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a></div>",
      "css": ":host{--paper:#f3f5f9;--sheet:#fff;--ink:#14171f;--ink-2:#4b5263;--ink-3:#626a7b;--rule:#e2e6ee;--rule-strong:#c9d0dc;--rail:#1b2c57;--rail-ink:#eef2fb;--rail-ink-2:#aebbd9;--rail-hover:#22376a;--rail-active:#2b4384;--blue:#256abf;--blue-wash:#eaf2fd;--red:#c4373a;--mark-0:#e6eaf1;--slot-line:#b9c1cf;--mark-1:#86b6ef;--mark-2:#3987e5;--mark-3:#1c5cab;--mark-4:#0d366b;}.ds-links{display:flex;gap:24px;font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;}.ds-link{display:inline-flex;align-items:center;gap:4px;font-size:.875rem;font-weight:500;color:var(--blue);text-decoration:none;text-underline-offset:3px}.ds-link:hover{text-decoration:underline}.ds-link:focus-visible{outline:2px solid var(--blue);outline-offset:2px;border-radius:4px}.ds-link-decision{color:var(--red)}"
    },
    {
      "name": "Range Control",
      "kind": "custom",
      "refersTo": "range-control",
      "description": "Segmented 7/30/90-day links; selection lives in the URL.",
      "html": "<div class=\"ds-range\" role=\"group\" aria-label=\"Time range\"><a class=\"ds-seg ds-seg-on\" href=\"#\" aria-current=\"true\">7 days</a><a class=\"ds-seg\" href=\"#\">30 days</a><a class=\"ds-seg\" href=\"#\">90 days</a></div>",
      "css": ":host{--paper:#f3f5f9;--sheet:#fff;--ink:#14171f;--ink-2:#4b5263;--ink-3:#626a7b;--rule:#e2e6ee;--rule-strong:#c9d0dc;--rail:#1b2c57;--rail-ink:#eef2fb;--rail-ink-2:#aebbd9;--rail-hover:#22376a;--rail-active:#2b4384;--blue:#256abf;--blue-wash:#eaf2fd;--red:#c4373a;--mark-0:#e6eaf1;--slot-line:#b9c1cf;--mark-1:#86b6ef;--mark-2:#3987e5;--mark-3:#1c5cab;--mark-4:#0d366b;}.ds-range{display:inline-flex;padding:2px;border:1px solid var(--rule);border-radius:8px;background:var(--sheet);font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;}.ds-seg{font-variant-numeric:tabular-nums;font-size:.875rem;padding:6px 12px;border-radius:6px;color:var(--ink-2);text-decoration:none;transition:background-color .15s,color .15s}.ds-seg:hover{background:var(--paper);color:var(--ink)}.ds-seg:focus-visible{outline:2px solid var(--blue);outline-offset:2px}.ds-seg-on,.ds-seg-on:hover{background:var(--rail);color:var(--rail-ink)}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Round status filter with its state mark and a tabular count.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-on\" type=\"button\" aria-pressed=\"true\">Everyone <span class=\"ds-n\">41</span></button><button class=\"ds-chip\" type=\"button\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" aria-hidden=\"true\"><rect x=\".75\" y=\".75\" width=\"8.5\" height=\"8.5\" rx=\"2.4\" fill=\"none\" stroke=\"var(--mark-2)\" stroke-width=\"1.5\"/></svg>Gone quiet <span class=\"ds-n\">6</span></button></div>",
      "css": ":host{--paper:#f3f5f9;--sheet:#fff;--ink:#14171f;--ink-2:#4b5263;--ink-3:#626a7b;--rule:#e2e6ee;--rule-strong:#c9d0dc;--rail:#1b2c57;--rail-ink:#eef2fb;--rail-ink-2:#aebbd9;--rail-hover:#22376a;--rail-active:#2b4384;--blue:#256abf;--blue-wash:#eaf2fd;--red:#c4373a;--mark-0:#e6eaf1;--slot-line:#b9c1cf;--mark-1:#86b6ef;--mark-2:#3987e5;--mark-3:#1c5cab;--mark-4:#0d366b;}.ds-chips{display:flex;gap:6px;font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;}.ds-chip{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--rule);background:var(--sheet);color:var(--ink-2);border-radius:9999px;padding:6px 12px;font:inherit;font-size:.875rem;cursor:pointer;transition:border-color .15s,color .15s}.ds-chip:hover{border-color:var(--rule-strong);color:var(--ink)}.ds-chip:focus-visible{outline:2px solid var(--blue);outline-offset:2px}.ds-n{font-variant-numeric:tabular-nums;color:var(--ink-3)}.ds-chip-on,.ds-chip-on:hover{background:var(--rail);border-color:var(--rail);color:var(--rail-ink)}.ds-chip-on .ds-n{color:var(--rail-ink-2)}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Hairline field; focus moves the border to register blue.",
      "html": "<label class=\"ds-field\"><svg class=\"ds-ico\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input class=\"ds-input\" placeholder=\"Search people\"></label>",
      "css": ":host{--paper:#f3f5f9;--sheet:#fff;--ink:#14171f;--ink-2:#4b5263;--ink-3:#626a7b;--rule:#e2e6ee;--rule-strong:#c9d0dc;--rail:#1b2c57;--rail-ink:#eef2fb;--rail-ink-2:#aebbd9;--rail-hover:#22376a;--rail-active:#2b4384;--blue:#256abf;--blue-wash:#eaf2fd;--red:#c4373a;--mark-0:#e6eaf1;--slot-line:#b9c1cf;--mark-1:#86b6ef;--mark-2:#3987e5;--mark-3:#1c5cab;--mark-4:#0d366b;}.ds-field{position:relative;display:block;width:320px;font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;}.ds-ico{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ink-3)}.ds-input{width:100%;box-sizing:border-box;border:1px solid var(--rule);border-radius:8px;background:var(--sheet);color:var(--ink);padding:8px 12px 8px 36px;font:inherit;font-size:.875rem}.ds-input::placeholder{color:var(--ink-3)}.ds-input:focus{outline:none;border-color:var(--blue)}"
    },
