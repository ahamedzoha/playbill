        "value": "420ms cubic-bezier(0.16, 1, 0.3, 1), from opacity 0.45 scale 0.55, stagger 18ms per mark",
        "purpose": "Marks ink in left to right when the range changes; disabled under prefers-reduced-motion."
      },
      {
        "name": "state-color",
        "value": "150ms (Tailwind transition-colors default)",
        "purpose": "Hover colour changes on nav, chips, segments, buttons."
      }
    ],
